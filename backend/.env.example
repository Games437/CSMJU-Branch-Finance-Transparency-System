# Copy this to .env and adjust if you change docker-compose.yml
DATABASE_URL="postgresql://bfts:bfts_dev_password@localhost:5432/bfts_dev?schema=public"
CORS_ORIGIN="http://localhost:3001"

# LINE OA quick-entry feature (backend/src/line/) — see
# LINE_OA_SETUP_GUIDE.md for how to obtain these from the LINE Developers
# Console. Leaving these unset does not crash the server: the webhook
# route fails closed with 401 (LineSignatureGuard), and outgoing replies
# are skipped with a warning log (LineClientService) — so the rest of the
# app keeps working in an environment that hasn't set up LINE yet.
LINE_CHANNEL_SECRET=""
LINE_CHANNEL_ACCESS_TOKEN=""
